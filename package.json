{
  "name": "@cookified/toastify",
  "version": "1.0.4",
  "description": "A delightful React toast notification library with folder stack animations and tactile micro-bevels.",
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./index.css": "./lib/index.css",
    "./styles.css": "./lib/styles.css",
    "./shadcn-theme.css": "./lib/shadcn-theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css",
    "./lib/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookified/toastify.git"
  },
  "keywords": [
    "react",
    "toast",
    "notifications",
    "toastify",
    "motion",
    "framer-motion",
    "animations",
    "react-19"
  ],
  "author": "Cookified",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:lib": "node scripts/prebuild.js && tsup && node scripts/postbuild.js",
    "build:site": "vite build",
    "build": "npm run build:lib && npm run build:site",
    "prepublishOnly": "rm -rf lib && npm run build:lib && npm test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "motion": "^12.0.0 || ^13.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
